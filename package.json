{
  "name": "jinling-mahjong",
  "version": "0.7.22",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.21"
  },
  "scripts": {
    "dev": "concurrently -k -n api,app \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:web": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "build": "npm run build:cocos && tsc --noEmit && vite build && node scripts/check-web-assets.mjs",
    "build:native": "npm run build:cocos && tsc --noEmit && vite build --mode native",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "check:deployment": "tsx scripts/check-auth-service.ts",
    "native:sync": "npm run build:native && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "format": "prettier --write src shared server tests docs *.ts *.json *.md",
    "start": "tsx server/index.ts",
    "icons": "node scripts/generate-icons.mjs",
    "tiles": "tsx scripts/build-sculpted-catalog.ts",
    "tiles:study": "tsx scripts/build-tile-study.ts",
    "test:soak": "playwright test -c playwright.soak.config.ts",
    "build:cocos": "node scripts/build-cocos.mjs",
    "check:web-assets": "node scripts/check-web-assets.mjs",
    "check:release:web": "npm test && npm run build && playwright test -c playwright.optimization.config.ts",
    "test:network": "playwright test -c playwright.network.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/share": "^8.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "javascript-obfuscator": "^5.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
