# Leave unset for the web app to use its own origin.
# Native packages require a reachable HTTPS service for friend rooms.
# Offline practice works without a service.
# VITE_GAME_SERVER_URL=https://mahjong.example.com
# PORT=8787
# DATABASE_PATH=data/mahjong.sqlite
# First-run seed only (off when unset); subsequent changes use 后台设置.
# Saved database policy takes precedence, including an explicit off switch.
# Only enable after both native platforms and the web release are available.
# MIN_CLIENT_VERSION=0.7.37
